{
	acme_ca {$CADDY_ACME_API:https://acme-v02.api.letsencrypt.org/directory}
}

# zrok2 controller API
zrok2.{$ZROK2_DNS_ZONE} {
	reverse_proxy zrok2-controller:{$ZROK2_CTRL_PORT}
	tls {
		dns route53
	}
}

# zrok2 public frontend — wildcard shares
*.{$ZROK2_DNS_ZONE} {
	reverse_proxy zrok2-frontend:{$ZROK2_FRONTEND_PORT}
	tls {
		dns route53
	}
}

# Ziti controller management API (upstream serves self-signed TLS)
ziti.{$ZROK2_DNS_ZONE} {
	reverse_proxy https://ziti-controller:{$ZITI_CTRL_PORT} {
		transport http {
			tls_insecure_skip_verify
		}
	}
	tls {
		dns route53
	}
}
