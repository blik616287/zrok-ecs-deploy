#!/bin/bash
set -euxo pipefail

# Register this instance to the zrok2 ECS cluster and enable task IAM roles
# (needed for the Caddy task role → Route53 DNS challenge).
cat >> /etc/ecs/ecs.config <<EOF
ECS_CLUSTER=${cluster_name}
ECS_ENABLE_TASK_IAM_ROLE=true
ECS_ENABLE_TASK_IAM_ROLE_NETWORK_HOST=true
EOF

# Fetch only the two zrok bootstrap scripts the zrok2-init container bind-mounts
# (lightweight curl instead of cloning the whole repo — faster, no git needed).
BASE=https://raw.githubusercontent.com/openziti/zrok/main
mkdir -p /opt/zrok2/repo/docker/compose/zrok2-instance /opt/zrok2/repo/nfpm
curl -fsSL --retry 5 --retry-delay 5 \
  -o /opt/zrok2/repo/docker/compose/zrok2-instance/entrypoint-init.bash \
  "$BASE/docker/compose/zrok2-instance/entrypoint-init.bash"
curl -fsSL --retry 5 --retry-delay 5 \
  -o /opt/zrok2/repo/nfpm/zrok2-bootstrap.bash \
  "$BASE/nfpm/zrok2-bootstrap.bash"
